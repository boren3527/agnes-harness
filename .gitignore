.superpowers/
node_modules/
dist/
*.tsbuildinfo
packages/package-manager/bundled-plugins/document-reader/src/runtime/
.agnes-tmp/

# A literal tilde directory: host defaults dataDir to the string "~/.agnes" and nothing
# expands it, so a run without an explicit dataDir writes here. Ignored so it cannot be
# committed again; the defect itself is being fixed in host.
~/
.agnes-scratch/

# Compiled at build time by packages/host/scripts/build-native.mjs (macOS only). Host helpers
# live in its ignored dist/ tree; C sources remain in packages/host/native/.
packages/host/native/macos-process-identity
packages/host/native/macos-live-app-identity

# Subagent worktrees live inside the repository; the fail-closed manager verifies this rule before
# creating one so the parent checkout cannot accidentally stage a nested worktree.
.worktrees/
.codegraph/

# Machine-local IDE settings and temporary Windows test output.
.idea/
/.windows-core-host-check.log
.agnes
.agh

# Managed per-workspace state for the AGH Blender bridge (created at runtime by the P0-3 probe).
.agh-blender/

learn/
.DS_Store

# Local assistant configuration and unpublished scratch material.
.claude/
.cursor/
outputs/
spikes/
docs/task-records/
# Python bytecode from the Blender bridge. Generated by running the bridge, not source.
__pycache__/
*.pyc

# Deliverables: the packs' scene_file points at these root-level .blend files (do not delete or move them - the pointer would dangle), but 10 MB binaries do not belong in the repo.
/*.blend

# Delivery artifacts for the 2026-10-13 modeling hand-off (independent-completion declaration, project note, runnable page, evidence docx, model renders, packaged folder and zip). They stay on disk next to the checkout but are not source, and the two local helper scripts below generate them.
/build-docx.ps1
/export-pdf.cmd
/independent-completion-declaration.pdf
/model-front.png
/model-preview.png
/独立完成声明.html
/项目说明.html
/可运行作品.html
/运行与验证证据.docx
/运行与验证证据-含实跑记录.docx
/交付-观物取像/
/交付-观物取像.zip
